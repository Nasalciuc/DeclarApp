# Copiaza in .env.local si completeaza din outputs-ul stack-ului SAM.
#
# ATENTIE Vercel: numele AWS_* sunt REZERVATE de platforma - de aceea
# aplicatia citeste APP_AWS_*. Local poti lasa APP_AWS_* necompletate si
# se foloseste lantul implicit (aws configure / AWS_PROFILE).

APP_AWS_REGION=eu-central-1
BUCKET=customs-analyzer-documents-<account-id>
DECLARATIONS_TABLE=<DeclarationsTableName din outputs>
HITL_FUNCTION_NAME=<HitlFunctionName din outputs>

# Cine semneaza corectiile HITL pana apare autentificarea (F2):
CORRECTED_BY=broker@firma.md

# Pe Vercel (obligatoriu acolo, optional local): un IAM user cu politica
# din infra/web-iam-policy.json.
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=
